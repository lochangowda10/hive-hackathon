# Copy this file to .env  (Windows:  copy .env.example .env)

# Security: change this to any long random string before first run
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite file created automatically in the backend folder)
DATABASE_URL=sqlite:///./swinglens.db

# LLM provider: "ollama" for local. (Cloud adapters arrive in the SaaS phase.)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Token lifetime in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Showcase / hackathon options ------------------------------------
# DEMO_MODE=1 seeds a demo account and shows a "Try the demo" button.
DEMO_MODE=0
# DEMO_PASSWORD=swingdemo123

# Cloud AI (only when Ollama isn't available, e.g. free cloud hosting).
# Groq's free tier (console.groq.com) costs nothing. Leave empty to keep
# everything local - the app still works, narration uses templates.
# LLM_PROVIDER=cloud
# CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=llama-3.1-8b-instant
